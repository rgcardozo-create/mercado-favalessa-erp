# PostgreSQL (Railway fornece essa string na aba "Connect" do serviço Postgres)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
# Defina como "false" apenas em Postgres local sem SSL
DATABASE_SSL=true

# Gere um valor aleatório longo, ex: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
JWT_EXPIRES_IN=8h

PORT=3000

# Senhas dos 3 usuários iniciais criados pelo `npm run seed` (obrigatórias, sem valor padrão)
SEED_MASTER_EMAIL=master@mercadofavalessa.local
SEED_MASTER_SENHA=
SEED_GERENTE_EMAIL=gerente@mercadofavalessa.local
SEED_GERENTE_SENHA=
SEED_LOJA_EMAIL=loja@mercadofavalessa.local
SEED_LOJA_SENHA=

# Senha adicional da Folha de pagamento (segunda camada, além do perfil Master).
# Sem ela, a tela de Folha fica inacessível. Gravada como hash pelo `npm run seed`.
FOLHA_SENHA=
# Quanto tempo a folha fica destravada depois de informar a senha
FOLHA_TOKEN_EXPIRES_IN=30m

# ── API Extratos do Banco do Brasil (opcional) ───────────────────────────────
# Busca o extrato da conta corrente direto no banco, em vez de baixar o arquivo.
# As credenciais saem da sua aplicação no Portal Developers BB (item Credenciais).
# NUNCA coloque estes valores no repositório: só nas variáveis do Railway.
# Passo a passo: docs/extrato-bb-api.md
BB_EXTRATOS_AMBIENTE=teste          # teste | producao
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_APP_KEY=                         # developer_application_key
BB_AGENCIA=                         # sem dígito e sem zeros à esquerda
BB_CONTA=                           # sem dígito e sem zeros à esquerda
# Certificado digital da empresa (mTLS), obrigatório pela API. Um dos dois jeitos:
BB_CERT_PFX_BASE64=                 # arquivo .pfx convertido em base64
BB_CERT_SENHA=                      # senha do .pfx
# BB_CERT_PEM_BASE64=               # ou: certificado .pem em base64
# BB_KEY_PEM_BASE64=                #     e a chave privada .pem em base64
# Nome da conta no cadastro de Bancos do sistema (é ela que guarda as regras)
BB_BANCO_NOME=Banco do Brasil
# Busca automática todo dia
BB_EXTRATOS_AUTOMATICO=false        # true para ligar
BB_EXTRATOS_HORA=07:00              # horário de Brasília
BB_EXTRATOS_DIAS=5                  # quantos dias para trás olhar em cada busca
