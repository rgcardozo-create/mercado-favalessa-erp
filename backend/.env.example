# PostgreSQL (Railway fornece essa string na aba "Connect" do serviço Postgres)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
# Defina como "false" apenas em Postgres local sem SSL
DATABASE_SSL=true

# Gere um valor aleatório longo, ex: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
JWT_EXPIRES_IN=8h

PORT=3000

# Senhas dos 3 usuários iniciais criados pelo `npm run seed` (obrigatórias, sem valor padrão)
SEED_MASTER_EMAIL=master@mercadofavalessa.local
SEED_MASTER_SENHA=
SEED_GERENTE_EMAIL=gerente@mercadofavalessa.local
SEED_GERENTE_SENHA=
SEED_LOJA_EMAIL=loja@mercadofavalessa.local
SEED_LOJA_SENHA=
